1310" y="758" as="sourcePoint"/><mxPoint x="1096" y="756" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q175" value="Price is locked here: full&#xa;price for a Critic, then 20%&#xa;off while Happy Hour is active." style="shape=note;size=10;align=left;verticalAlign=top;spacingLeft=5;spacingTop=1;fontSize=10;fontFamily=Helvetica;fontColor=#000000;fillColor=#fffde7;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="1310" y="872" width="165" height="44" as="geometry"/></mxCell><mxCell id="q176" value="" style="endArrow=none;dashed=1;html=0;strokeColor=#9e9e9e;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1310" y="884" as="sourcePoint"/><mxPoint x="501" y="880" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q177" value="READY, then SERVED, and&#xa;c4 starts EATING." style="shape=note;size=10;align=left;verticalAlign=top;spacingLeft=5;spacingTop=1;fontSize=10;fontFamily=Helvetica;fontColor=#000000;fillColor=#fffde7;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="1310" y="1140" width="165" height="30" as="geometry"/></mxCell><mxCell id="q178" value="" style="endArrow=none;dashed=1;html=0;strokeColor=#9e9e9e;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1310" y="1152" as="sourcePoint"/><mxPoint x="1226" y="1152" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q179" value="Pasta takes 2 units, so o4 is&#xa;READY after turn 12." style="shape=note;size=10;align=left;verticalAlign=top;spacingLeft=5;spacingTop=1;fontSize=10;fontFamily=Helvetica;fontColor=#000000;fillColor=#fffde7;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="1310" y="1348" width="165" height="30" as="geometry"/></mxCell><mxCell id="q180" value="" style="endArrow=none;dashed=1;html=0;strokeColor=#9e9e9e;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1310" y="1360" as="sourcePoint"/><mxPoint x="1226" y="1360" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q181" value="Charges the locked price;&#xa;nothing is recalculated." style="shape=note;size=10;align=left;verticalAlign=top;spacingLeft=5;spacingTop=1;fontSize=10;fontFamily=Helvetica;fontColor=#000000;fillColor=#fffde7;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="1310" y="1544" width="165" height="30" as="geometry"/></mxCell><mxCell id="q182" value="" style="endArrow=none;dashed=1;html=0;strokeColor=#9e9e9e;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1310" y="1556" as="sourcePoint"/><mxPoint x="1226" y="1552" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q183" value="Only WAITING, SEATED or&#xa;ORDERED customers lose." style="shape=note;size=10;align=left;verticalAlign=top;spacingLeft=5;spacingTop=1;fontSize=10;fontFamily=Helvetica;fontColor=#000000;fillColor=#fffde7;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="1310" y="1748" width="165" height="30" as="geometry"/></mxCell><mxCell id="q184" value="" style="endArrow=none;dashed=1;html=0;strokeColor=#9e9e9e;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1310" y="1760" as="sourcePoint"/><mxPoint x="1096" y="1760" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q185" value="After turn 18, all three&#xa;targets are met: 5 paid,&#xa;$83.13 and an average&#xa;of 85.6." style="shape=note;size=10;align=left;verticalAlign=top;spacingLeft=5;spacingTop=1;fontSize=10;fontFamily=Helvetica;fontColor=#000000;fillColor=#fffde7;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="1310" y="1864" width="165" height="56" as="geometry"/></mxCell><mxCell id="q186" value="" style="endArrow=none;dashed=1;html=0;strokeColor=#9e9e9e;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1310" y="1876" as="sourcePoint"/><mxPoint x="376" y="1868" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q207" value="Customer 4 (the Critic) in docs/test-runs/stage3-victory.txt. Each pass of the loop is one turn; the grey&#xa;tags give the turns in which each fragment runs. Other customers are not shown. Also left out: lookups&#xa;and getters (findCustomer(), getWaiter(), ...), Table.seat()/release(), the Happy Hour recovery and&#xa;ActionResult returns." style="shape=note;size=10;align=left;verticalAlign=top;spacingLeft=5;spacingTop=1;fontSize=10;fontFamily=Helvetica;fontColor=#000000;fillColor=#fffde7;strokeColor=#9e9e9e;" vertex="1" parent="1"><mxGeometry x="250" y="14" width="590" height="58" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>